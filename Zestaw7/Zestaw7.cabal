cabal-version:   3.0
name:            Zestaw7
version:         0.1.0.0
license:         BSD-3-Clause
license-file:    LICENSE
author:          Maciej
maintainer:      maciejserafin2300@gmail.com
build-type:      Simple
extra-doc-files: CHANGELOG.md

common warnings
    ghc-options: -Wall

executable Zestaw7
    import:           warnings
    main-is:          Main.hs
    build-depends:    base ^>=4.21.0.0,scotty,aeson,random
    hs-source-dirs:   app
    default-language: Haskell2010
    ghc-options: -threaded
